# direct: existing VisualAI Edge /offer server
# mediamtx: MediaMTX WHEP endpoint
VITE_FACTORY_STREAM_MODE=direct

# Direct mode example:
# WebRTC is UDP-first. The VisualAI Edge `video_sender` profile defaults to
# a low-latency 320x180 frame at 15 FPS; increase it only after testing.
VITE_FACTORY_STREAM_URL=http://192.168.0.137:8000
#
# Local MediaMTX example:
# VITE_FACTORY_STREAM_MODE=mediamtx
# VITE_FACTORY_STREAM_URL=http://127.0.0.1:8889/jutemill-gate/whep
#
# Production MediaMTX example:
# VITE_FACTORY_STREAM_MODE=mediamtx
# VITE_FACTORY_STREAM_URL=https://stream.sukalyanai.com/jutemill-gate/whep

# VisualAI Edge AlertServer Socket.IO URL (listens for alert_received).
VITE_FACTORY_ALERT_URL=http://192.168.0.137:5000
# For the public Contabo relay:
# VITE_FACTORY_ALERT_URL=https://socket.sukalyanai.com
# VITE_FACTORY_SOCKET_TOKEN=set-this-locally-or-with-a-GitHub-secret

# Alert transport: socketio (existing) or mqtt.
VITE_FACTORY_ALERT_MODE=socketio

# MQTT browser connections require WS/WSS; native MQTT port 1883 will not work.
# Local HTTP frontend example:
# VITE_FACTORY_ALERT_MODE=mqtt
# VITE_FACTORY_MQTT_URL=ws://178.238.231.143:9001/mqtt
# VITE_FACTORY_MQTT_TOPIC=test/topic
# VITE_FACTORY_MQTT_USERNAME=your-user
# VITE_FACTORY_MQTT_PASSWORD=your-password
#
# Hostinger must use a TLS WebSocket endpoint:
# VITE_FACTORY_MQTT_URL=wss://mqtt.sukalyanai.com/mqtt
